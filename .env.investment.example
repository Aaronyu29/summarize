# Dedicated investment service. No credential values belong in Git.
INVEST_DATABASE=/var/lib/rhino-invest/investment.sqlite
INVEST_ARCHIVE_DATABASE=/opt/rhino-video-digest/data/library.sqlite
INVEST_SYMBOLS=TSM,SOXX
INVEST_INTERVAL_SECONDS=60
# Keep automatic report/risk/watch/operations messages quiet during acceptance.
# Enable explicitly after review; quotes/research/Bitable sync continue when false.
INVEST_NOTIFICATIONS_ENABLED=false
INVEST_FEISHU_APP_ID=
INVEST_FEISHU_APP_SECRET=
INVEST_FEISHU_APP_TOKEN=
INVEST_FEISHU_CHAT_ID=
# Optional custom bot notification route when no chat_id is configured.
# Copy the authorized existing bot URL into this investment-only setting privately.
INVEST_FEISHU_WEBHOOK_URL=
INVEST_FEISHU_WEBHOOK_SECRET=
# Legacy LARK_WEBHOOK_URL/LARK_WEBHOOK is ignored unless this is explicitly true.
INVEST_REUSE_LARK_WEBHOOK=false
# Only longbridge official credentials consumed by the installed AKShare adapter.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
# Paid model is disabled until explicitly configured and reviewed.
INVEST_MODEL_ENABLED=false
INVEST_MODEL_NAME=
INVEST_MODEL_BASE_URL=
INVEST_MODEL_API_KEY_ENV=INVEST_RESEARCH_API_KEY
INVEST_RESEARCH_API_KEY=
INVEST_MODEL_MAX_CALLS_PER_DAY=0
INVEST_MODEL_MAX_COST_USD_PER_DAY=0
INVEST_MODEL_MAX_COST_USD_PER_CALL=0
# Optional hot-loaded daily limits (initialize the JSON before enabling it).
# INVEST_MODEL_BUDGET_FILE=/var/lib/rhino-invest/model-budget.json
# DeepSeek Flash production generation controls; all participate in request identity.
INVEST_MODEL_THINKING=disabled
INVEST_MODEL_REASONING_EFFORT=none
INVEST_MODEL_MAX_TOKENS=12000
INVEST_MODEL_CONFIGURATION_REVISION=2
